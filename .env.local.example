# Supabase — FIC runs on the existing FTA project (zvkercqohmmeyofycbgr). Keep the engine, rebuild the experience.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only: consensus aggregates, proposal resolution, seed scripts
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Market data — Polygon. Free tier = 5 req/min, end-of-day. Starter = unlimited, 15-min delayed → set POLYGON_RPM=300.
POLYGON_API_KEY=
POLYGON_RPM=5

# Demo / strictness (Backend Cutover Plan §1.2)
# FIC_DEMO=1 lets signed-out visitors browse the fixture demo (default: on for local + preview, off in production).
# FIC_STRICT_LIVE=1 makes a live reader that returns null THROW instead of showing a fixture (used by `npm run smoke:live`).
FIC_DEMO=
FIC_STRICT_LIVE=

# Platform services ported from fta-dashboard (needed by cutover — see docs/BACKEND-CUTOVER-PLAN.md §4)
CRON_SECRET=
PUSH_DISPATCH_SECRET=          # must equal Supabase Vault secret `push_dispatch_secret`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SHOP_STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
MARKETING_FROM_EMAIL=
MARKETING_TOKEN_SECRET=
FB_LEADS_VERIFY_TOKEN=

# ── Ported from fta-dashboard (Phases 5–6). Every one of these fails CLOSED: the route answers
# a 503 "not configured" and logs [not-configured] <ENV> rather than half-working. ──
NEXT_PUBLIC_APP_ORIGIN=            # canonical origin for links in emails/push (https://app.familyinvestingclub.com)
MARKETING_REPLY_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=               # shared with Kai inbound — SMS campaigns are always dry-run
# Stripe price ids (club subscription + challenge VIP + order bumps)
CLUB_MONTHLY_PRICE_ID=
VIP_TICKET_PRICE_ID=
BUMP_TEXTBOOK_PRICE_ID=
BUMP_PARENTS_BUNDLE_PRICE_ID=
BUMP_KIDS_BUNDLE_PRICE_ID=
# Physical fulfilment (shop lane only)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=
SHOPIFY_TEXTBOOK_VARIANT_ID=
SHOPIFY_KIDS_BUNDLE_VARIANT_ID=
LULU_API_BASE=
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# Cross-links kept while the challenge cohort still runs on fta-dashboard
FTA_CHALLENGE_URL=
CLUB_CONTINUE_URL=
NEXT_PUBLIC_CLUB_HOST_LIVE=
